{
  // Cloudflare Workers config for the OpenNext build (`npm run cf:build`, `npm run cf:deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almashriq",
  "main": ".open-next/worker.js",
  // Workers Paid (10 MB limit). Minified it is ~2.8 MB gzipped (3.3 MB without), which also starts faster.
  "minify": true,
  // Keep variables added in the Cloudflare dashboard (e.g. RESEND_API_KEY) when deploying from here.
  "keep_vars": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Logs keep the path but not the ?query (it can carry tokens, emails or search terms).
  "observability": { "enabled": true, "redact_query_string": true },
  // Run the Worker near the database (Supabase, Mumbai) when that is faster: most pages make several queries.
  "placement": { "mode": "smart" },
  // The live site. Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "www.almashriqtrading.site", "custom_domain": true },
    { "pattern": "almashriqtrading.site", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "almashriq-photos" },
    // Private documents (no public domain): payment slips, receipts, support files, remittance and vehicle docs.
    { "binding": "DOCS", "bucket_name": "almashriq-docs" },
    // Next.js page and data cache (open-next.config.ts). In Asia, near the visitors and the database.
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "almashriq-cache-apac" }
  ],
  // revalidateTag timestamps for the Next.js cache (open-next.config.ts).
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "almashriq-tag-cache", "database_id": "5f675b36-6fb7-4cfd-a520-0e11c535de30" }
  ],
  // Public values (also baked into the build). Secrets — SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY,
  // ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET — are set in the Cloudflare dashboard, never in this file.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://rhttfwrzhuaglcjpxuja.supabase.co",
    // Supabase publishable key (replaces the legacy anon JWT): public by design, it is in every
    // browser; RLS protects the data. The variable keeps its old name so no code had to change.
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_4ROQ6iHvu7iDYEPp5SPh7Q_MfTf6Yoh",
    "NEXT_PUBLIC_SITE_URL": "https://www.almashriqtrading.site",
    "NEXT_PUBLIC_PHOTO_URL": "https://photos.almashriqtrading.site",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFwNaxY7pBdG5KC3"
  }
}
